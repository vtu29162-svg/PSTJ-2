class Solution {
    public String dayOfTheWeek(int day, int month, int year) {
        String[] week = {
            "Sunday", "Monday", "Tuesday", "Wednesday",
            "Thursday", "Friday", "Saturday"
        };

        // 1971-01-01 was Friday
        int totalDays = 0;

        // Count complete years
        for (int y = 1971; y < year; y++) {
            if (isLeap(y))
                totalDays += 366;
            else
                totalDays += 365;
        }

        int[] days = {31, 28, 31, 30, 31, 30,
                      31, 31, 30, 31, 30, 31};

        // Count complete months
        for (int m = 1; m < month; m++) {
            totalDays += days[m - 1];

            if (m == 2 && isLeap(year)) {
                totalDays++;
            }
        }

        // Count days
        totalDays += day - 1;

        // Friday = index 5
        return week[(totalDays + 5) % 7];
    }

    private boolean isLeap(int year) {
        return year % 400 == 0 ||
               (year % 4 == 0 && year % 100 != 0);
    }
}
